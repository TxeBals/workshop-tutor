# Backend: ollama | openai_compat | openrouter
FORJA_BACKEND=ollama
OLLAMA_BASE_URL=http://localhost:11434/v1
# 16 GB laptop: qwen3:8b · 32 GB Mac / 24 GB GPU: qwen3-coder:30b · alternative: devstral
FORJA_MODEL=qwen3:8b

# Shared classroom server (vLLM / LiteLLM / LM Studio):
# FORJA_BACKEND=openai_compat
# FORJA_BASE_URL=http://<server>:8000/v1
# FORJA_MODEL=Qwen/Qwen3-Coder-30B-A3B-Instruct
# FORJA_API_KEY=x

# OpenRouter (open-weight only; anthropic/*, openai/* and gpt-oss are blocked in code):
# FORJA_BACKEND=openrouter
# OPENROUTER_API_KEY=sk-or-...
# FORJA_MODEL=deepseek/deepseek-v3.2
